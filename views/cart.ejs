<%- include('header') %><h1>My cart</h1><p>One seller per order. Checkout reserves stock and creates a pending order.</p><table><thead><tr><th>Product</th><th>Unit price</th><th>Quantity</th><th>Subtotal</th><th>Update</th></tr></thead><tbody><% items.forEach(i => { %><tr><td><%= i.product.productName %></td><td>RM <%= money(i.product.price) %></td><td><%= i.quantity %></td><td>RM <%= money(i.quantity * i.product.price) %></td><td><form method="post" action="/cart/items"><input type="hidden" name="productId" value="<%= i.productId %>"><input aria-label="Quantity" class="quantity" type="number" min="0" step="1" name="quantity" value="<%= i.quantity %>" required><button>Update</button></form><small>Use 0 to remove this item.</small></td></tr><% }); %></tbody></table><h2>Total: RM <%= money(total) %></h2><% if (items.length) { %><form method="post" action="/checkout"><button>Place order</button> <a class="button gray" href="/cart/clear">Clear cart</a></form><% } else { %><p>Your cart is empty.</p><% } %><p><a href="/products">Continue shopping</a></p><%- include('footer') %>
