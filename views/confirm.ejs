<%- include('header') %><h1><%= title %></h1><p class="message error">Check the details before confirming.</p><table><tbody><% details.forEach(row => { %><tr><th><%= row[0] %></th><td><%= row[1] %></td></tr><% }); %></tbody></table><form method="post" action="<%= action %>"><button class="danger">Yes, confirm</button> <a class="button gray" href="<%= back %>">Cancel</a></form><%- include('footer') %>
