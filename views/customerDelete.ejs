<%- include('header') %>
<h1>Delete customer</h1>
<p class="message error">Are you sure you want to delete this customer?</p>
<table>
  <tr><th>Customer ID</th><td><%= customer.customerId %></td></tr>
  <tr><th>Name</th><td><%= customer.name %></td></tr>
  <tr><th>Email</th><td><%= customer.email %></td></tr>
  <tr><th>Phone</th><td><%= customer.phone %></td></tr>
  <tr><th>Address</th><td><%= customer.address %></td></tr>
</table>
<form class="row" method="post" action="/customers/<%= customer.customerId %>/delete">
  <button class="danger">Yes, delete</button>
  <a class="button gray" href="/customers">Cancel</a>
</form>
<%- include('footer') %>
