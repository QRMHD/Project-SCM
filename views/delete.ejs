<%- include('header') %>
<h1>Delete <%= config.singular %></h1>
<p class="message error">Are you sure you want to delete this <%= config.singular %>?</p>
<table>
  <% config.columns.forEach((column) => { %>
    <tr><th><%= column.label %></th><td><%= column.value(item) %></td></tr>
  <% }) %>
</table>
<form class="row" method="post" action="<%= config.path %>/<%= item[config.idKey] %>/delete">
  <button class="danger">Yes, delete</button>
  <a class="button gray" href="<%= config.path %>">Cancel</a>
</form>
<%- include('footer') %>
