<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Online Local Mart System</title><link rel="stylesheet" href="/style.css"></head><body>
<header><a class="brand" href="/products">OLMS</a><nav><a href="/products">Products</a>
<% if (user) { %><a href="/orders">Orders</a><a href="/payments">Payments</a>
<% if (user.role === 'Customer') { %><a href="/cart">Cart</a><% } %>
<% if (user.role === 'Admin') { %><a href="/categories">Categories</a><a href="/customers">Customers</a><a href="/sellers">Sellers</a><a href="/admins">Admins</a><% } %>
<a href="/profile">Profile</a><form class="inline" action="/logout" method="post"><button>Log out</button></form>
<% } else { %><a href="/login">Log in</a><a href="/register">Register</a><% } %></nav></header><main>
<% if (user) { %><p class="identity">Signed in as <%= user.name %> · <%= user.role %><% if (user.role === 'Seller') { %> · <%= user.accountStatus %><% } %></p><% } %>
<% if (message) { %><p class="message"><%= message %></p><% } %><% if (error) { %><p class="message error"><%= error %></p><% } %>
