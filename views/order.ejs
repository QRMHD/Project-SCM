<%- include('header') %><h1>Order <%= order.orderId %></h1><p class="message">Status: <strong><%= order.orderStatus %></strong></p><p>Customer: <%= system.users.findById(order.customerId).name %> · Seller: <%= system.users.findById(order.sellerId).name %></p><p>Date: <%= order.orderDate %></p><p>Delivery address: <%= order.address %></p><table><thead><tr><th>Product</th><th>Unit price</th><th>Quantity</th><th>Subtotal</th></tr></thead><tbody><% order.items.forEach(i => { %><tr><td><%= i.productName %></td><td>RM <%= money(i.price) %></td><td><%= i.quantity %></td><td>RM <%= money(i.price * i.quantity) %></td></tr><% }); %></tbody></table><h2>Total: RM <%= money(order.totalAmount) %></h2>
<% if (order.orderStatus === 'Pending' && user.role === 'Customer') { %><h2>Simulated payment</h2><p>No real payment is taken.</p><form method="post" action="/orders/<%= order.orderId %>/pay"><label>Simulation result<select name="outcome"><option>Success</option><option>Failed</option></select></label><button>Run simulated payment</button></form><% } %>
<% const statuses = order.orderStatus === 'Pending' ? ['Cancelled'] : (user.role !== 'Customer' ? ({ Paid: ['Processing'], Processing: ['Shipped'], Shipped: ['Completed'] }[order.orderStatus] || []) : []); %>
<% if (statuses.length) { %><h2>Update order</h2><form method="post" action="/orders/<%= order.orderId %>/status"><select name="orderStatus"><% statuses.forEach(s => { %><option><%= s %></option><% }); %></select><button>Update status</button></form><% } %>
<% if (order.orderStatus === 'Cancelled' && user.role !== 'Seller') { %><p><a class="button danger" href="/orders/<%= order.orderId %>/delete">Delete cancelled order</a></p><% } %><h2>Payment attempts</h2><%- include('paymentTable', { records: payments }) %><p><a href="/orders">All orders</a></p><%- include('footer') %>
