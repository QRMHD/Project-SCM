<table><thead><tr><th>Order ID</th><th>Customer ID</th><th>Seller ID</th><th>Date</th><th>Total</th><th>Status</th><th>Details</th></tr></thead><tbody><% records.forEach(o => { %><tr><td><%= o.orderId %></td><td><%= o.customerId %></td><td><%= o.sellerId %></td><td><%= o.orderDate.slice(0,10) %></td><td>RM <%= money(o.totalAmount) %></td><td><%= o.orderStatus %></td><td><a href="/orders/<%= o.orderId %>">View order</a></td></tr><% }); %></tbody></table>
