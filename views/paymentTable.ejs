<table><thead><tr><th>Payment ID</th><th>Order ID</th><th>Amount</th><th>Status</th><th>Action</th></tr></thead><tbody><% records.forEach(p => { %><tr><td><%= p.paymentId %></td><td><a href="/orders/<%= p.orderId %>"><%= p.orderId %></a></td><td>RM <%= money(p.amount) %></td><td><%= p.paymentStatus %></td><td><% if (p.paymentStatus === 'Failed' && user.role !== 'Seller') { %><a href="/payments/<%= p.paymentId %>/delete">Delete failed attempt</a><% } %></td></tr><% }); %></tbody></table>
