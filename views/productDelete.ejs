<%- include('header') %>
<h1>Delete product</h1>
<p class="message error">Are you sure you want to delete this product?</p>
<table>
  <tr><th>Product ID</th><td><%= product.productId %></td></tr>
  <tr><th>Product name</th><td><%= product.productName %></td></tr>
  <tr><th>Category</th><td><%= product.category %></td></tr>
  <tr><th>Price (RM)</th><td><%= product.price.toFixed(2) %></td></tr>
  <tr><th>Stock quantity</th><td><%= product.stockQuantity %></td></tr>
</table>
<form class="row" method="post" action="/products/<%= product.productId %>/delete">
  <button class="danger">Yes, delete</button>
  <a class="button gray" href="/products">Cancel</a>
</form>
<%- include('footer') %>
