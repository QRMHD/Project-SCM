<%- include('header') %><h1>My profile</h1><p>User ID: <%= user.userId %></p><form method="post" action="/profile">
<% [['name','Name','text'],['email','Email','email'],['password','New password (optional)','password']].concat(user.role === 'Customer' ? [['phone','Phone','text'],['address','Address','text']] : []).forEach(f => { %><label><%= f[1] %><input name="<%= f[0] %>" type="<%= f[2] %>" value="<%= f[2] === 'password' ? '' : (formData[f[0]] || '') %>" <%= f[2] !== 'password' ? 'required' : '' %>></label><% }); %><button>Save profile</button></form><%- include('footer') %>
