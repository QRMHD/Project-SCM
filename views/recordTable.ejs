<div class="table-wrap"><table><thead><tr><th>ID</th><% config.fields.filter(f => f.type !== 'password').forEach(f => { %><th><%= f.label %></th><% }); %><th>Actions</th></tr></thead><tbody>
<% records.forEach(record => { %><tr><td><%= record[config.id] %></td><% config.fields.filter(f => f.type !== 'password').forEach(f => { %><td><%= displayValue(record, f.name) %></td><% }); %><td>
<% if (user && (user.role === 'Admin' || (key === 'products' && user.role === 'Seller' && user.accountStatus === 'Approved' && record.sellerId === user.userId))) { %><a class="button" href="/<%= key %>/<%= record[config.id] %>/edit">Edit</a> <a class="button danger" href="/<%= key %>/<%= record[config.id] %>/delete">Delete</a><% } %>
<% if (user && user.role === 'Customer' && key === 'products') { %><form method="post" action="/cart/items"><input type="hidden" name="productId" value="<%= record.productId %>"><input type="hidden" name="operation" value="add"><label>Quantity<input class="quantity" name="quantity" type="number" min="1" step="1" value="1" required></label><button <%= record.stockQuantity === 0 ? 'disabled' : '' %>>Add to cart</button></form><% } %>
</td></tr><% }); %></tbody></table></div><% if (!records.length) { %><p>No records to display.</p><% } %>
