<%- include('header') %><h1>Create account</h1><form method="post" action="/register"><label>Account type<select name="role"><option>Customer</option><option>Seller</option></select></label>
<% [['name','Name','text'],['email','Email','email'],['password','Password (minimum 8 characters)','password'],['phone','Phone (customers)','text'],['address','Address (customers)','text']].forEach(f => { %><label><%= f[1] %><input name="<%= f[0] %>" type="<%= f[2] %>" value="<%= f[2] === 'password' ? '' : (formData[f[0]] || '') %>" <%= ['name','email','password'].indexOf(f[0]) !== -1 ? 'required' : '' %>></label><% }); %><button>Register</button></form><%- include('footer') %>
