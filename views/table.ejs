<table>
  <thead>
    <tr>
      <% config.columns.forEach((column) => { %><th><%= column.label %></th><% }) %>
      <% if (showActions) { %><th>Action</th><% } %>
    </tr>
  </thead>
  <tbody>
    <% rows.forEach((item) => { %>
      <tr>
        <% config.columns.forEach((column) => { %><td><%= column.value(item) %></td><% }) %>
        <% if (showActions) { %>
          <td>
            <a class="button" href="<%= config.path %>/<%= item[config.idKey] %>/edit">Edit</a>
            <a class="button danger" href="<%= config.path %>/<%= item[config.idKey] %>/delete">Delete</a>
          </td>
        <% } %>
      </tr>
    <% }) %>
  </tbody>
</table>
